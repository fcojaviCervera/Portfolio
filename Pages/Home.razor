            <span>franciscojavier.cervera7@gmail.com</span>
        </a>
        <a href="https://linkedin.com/in/franciscojavier-cervera-muñoz" target="_blank" rel="noopener noreferrer" class="contact-item">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
