@page "/"

<PageTitle>Javier Cervera — Portfolio</PageTitle>

<section id="inicio" class="hero">
    <h1>Javier Cervera Muñoz</h1>
    <p class="subtitle">Desarrollador .NET</p>
    <div class="hero-actions">
        <a href="#proyectos" class="btn-primary">Ver proyectos</a>
        <a href="files/CV_Francisco_Javier_Cervera.pdf" download="CV_Francisco_Javier_Cervera.pdf" class="btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Descargar CV
        </a>
        <a href="#contacto" class="btn-secondary">Contacto</a>
    </div>
</section>

<section id="sobre-mi">
    <h2>Sobre mí</h2>
    <div class="section-contenido">
        <p>
            Soy ingeniero de software especializado en desarrollo .NET, con más de 10 años de
            experiencia construyendo y manteniendo aplicaciones backend, desde sistemas de gestión
            hasta integraciones con colas de mensajería (RabbitMQ) y bases de datos relacionales y
            no relacionales (SQL Server, MySQL, Oracle, MongoDB, Redis).
        </p>
        <p>
            A lo largo de mi carrera he combinado el desarrollo de nuevos evolutivos con la
            resolución de incidencias en producción, moviéndome con soltura entre C#, TypeScript y
            WPF, además de tecnologías cloud y de contenedores como Docker, AWS y Azure. Me gusta
            entender bien el problema de negocio antes de escribir código, y cuidar tanto la
            arquitectura como los detalles que hacen que una aplicación sea fácil de mantener.
        </p>
    </div>
</section>

<section id="experiencia">
    <h2>Experiencia</h2>
    <div class="section-contenido">
        <div class="timeline">

            @foreach (var item in CvData.Experience)
            {
                <div class="timeline-item">

                    <span class="timeline-dot"></span>
                    <div class="timeline-content">

                        <h3> @item.Role</h3>
                        <p class="company"> @item.Company @(item.Location is not null ? $" · {item.Location}" : "")</p>
                        <p class="period"> @item.Period </p>
                        @if (item.Description is not null)
                        {
                            <p class="desc"> @item.Description</p>
                        }
                        @if (item.Technologies is not null)
                        {
                            <div class="tags">
                                <strong>Tecnologías:</strong>

                                @foreach (var tech in item.Technologies)
                                {
                                    <span class="tag">
                                        @tech
                                    </span>

                                }
                            </div>
                        }

                    </div>
                </div>
            }
        </div>
    </div>

</section>

<section id="tecnologias">
    <h2>Tecnologías</h2>
    <div class="tech-groups">

        @foreach (var category in CvData.Technologies)
        {
            <div class="tech-category">
                <h3> @category.Title</h3>
                <div class="tech-grid">
                    @foreach (var tech in category.Items)
                    {
                        <div class="tech-item">
                            <i class="@tech.Icon"></i>
                            <span class="tech-name">@tech.Name</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

<Proyectos />

