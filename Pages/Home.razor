@page "/"

<PageTitle>Francisco Javier Cervera — Portfolio</PageTitle>

<section id="inicio" class="hero">
    <h1>Francisco Javier Cervera Muñoz</h1>
    <p class="subtitle">Desarrollador .NET</p>
    <div class="hero-actions">
        <a href="#proyectos">Ver proyectos</a>
        <a href="#contacto">Contacto</a>
    </div>
</section>

<section id="sobre-mi">
    <h2>Sobre mí</h2>
    <div class="section-contenido">
        <p>
            Ingeniero de software especializado en desarrollo .NET, con experiencia
            en backend, bases de datos y aplicaciones de gestión.
        </p>
        <p>
            Me desenvuelvo bien en el desarrollo de nuevos evolutivos y en la resolución de incidencias.
        </p>
    </div>
</section>

<section id="experiencia">
    <h2>Experiencia</h2>
    <div class="section-contenido">
        <div class="timeline">

            @foreach (var item in CvData.Experience)
            {
                <div class="timeline-item">

                    <span class="timeline-dot"></span>
                    <div class="timeline-content">

                        <h3> @item.Role</h3>
                        <p class="company"> @item.Company @(item.Location is not null ? $" · {item.Location}" : "")</p>
                        <p class="period"> @item.Period </p>
                        @if (item.Description is not null)
                        {
                            <p class="desc"> @item.Description</p>
                        }
                        @if (item.Technologies is not null)
                        {
                            <div class="tags">
                                <strong>Tecnologías:</strong>

                                @foreach (var tech in item.Technologies)
                                {
                                    <span class="tag">
                                        @tech
                                    </span>

                                }
                            </div>
                        }

                    </div>
                </div>
            }
        </div>
    </div>

</section>

<section id="tecnologias">
    <h2>Tecnologías</h2>
    <div class="tech-groups">

        @foreach (var category in CvData.Technologies)
        {
            <div class="tech-category">
                <h3> @category.Title</h3>
                <div class="tech-grid">
                    @foreach (var tech in category.Items)
                    {
                        <div class="tech-item">
                            <i class="@tech.Icon"></i>
                            <span class="tech-name">@tech.Name</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

<section id="proyectos">
    <h2>Proyectos</h2>
    <div class="projects-grid">

        <article class="project-card">
            <div class="project-header">
                <div class="project-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                        <line x1="8" y1="7" x2="16" y2="7"/>
                        <line x1="8" y1="11" x2="14" y2="11"/>
                    </svg>
                </div>
                <div class="project-links">
                    <a href="https://github.com/fcojaviCervera/TinyLibrary" target="_blank" rel="noopener noreferrer" title="Ver en GitHub">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
                        </svg>
                    </a>
                </div>
            </div>
            <div class="project-body">
                <h3>TinyLibrary</h3>
                <p class="project-desc">
                    API REST de gestión de bibliotecas construida con Clean Architecture. Permite el alta de libros y socios, gestión de préstamos con reglas de negocio (máximo 3 préstamos simultáneos, duración por defecto de 14 días) y devoluciones con sistema de penalizaciones. Desarrollada con .NET 10, EF Core, SQLite y FluentValidation.
                </p>
                <div class="project-tags">
                    <span>.NET 10</span>
                    <span>C#</span>
                    <span>EF Core</span>
                    <span>Clean Architecture</span>
                    <span>REST API</span>
                </div>
            </div>
        </article>

    </div>
</section>

